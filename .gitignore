# Temp files and dirs
temp/
tmp/

# Nodejs
node_modules

# Build artifacts (all final outputs land in releases/)
releases/
electron-ui/dist/
tray-app/dist/
chrome-extension/lib/*.wasm

# Downloaded on demand by scripts/download-vc-redist.mjs before Windows builds.
# Bundled into the Windows installer so onnxruntime-node's native binary can
# load on fresh Windows installs without the user installing VC++ Redist.
build-resources/vc_redist.x64.exe

# Staged on demand by scripts/bundle-vc-runtime.mjs before the Microsoft Store
# (MSIX) build — the CRT DLLs ship app-local inside the package. Keep the dir
# (.gitkeep) but not its DLLs.
build-resources/win-runtime/*.dll

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*

# IDE / editor
.idea/
.vscode/
*.swp

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Apple signing artifacts (provided locally / via CI secret, never committed)
*.provisionprofile
*.p12
*.cer
